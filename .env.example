# Copie este arquivo para .env.local (que é ignorado pelo git) e preencha os valores.
# NUNCA coloque senhas, connection strings, service_role ou sb_secret_* neste arquivo
# nem em qualquer variável NEXT_PUBLIC_*: elas são publicadas no navegador.

# URL pública usada em canonical, robots.txt e sitemap.xml.
# Local: http://localhost:3000 — Produção: https://xaviercollection.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Projeto Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
# Chave PUBLICÁVEL (sb_publishable_... ou a chave "anon" legada). Nunca a secreta.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
